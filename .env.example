# Copy to .env (docker compose reads it) or export these in your shell.

# Signs staff session cookies. Use a long random string outside a laptop demo.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file used by the app. Defaults to data/app.db.
DATABASE_URL=sqlite:///data/app.db

# What QR codes and party links point to. For a phone on the same Wi-Fi, use this
# computer's LAN address, e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=http://localhost:8000

# Optional: freeze the app's "today" (YYYY-MM-DD) for reproducible demos and tests.
APP_TODAY=

# Docker only: run `manage.py demo` on first start when no database exists.
SEED_ON_START=true
